# ==============================================================================
# RevivePilot — Root Environment Configuration
# ==============================================================================

# Backend SMTP Credentials
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_APP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME="RevivePilot Revenue Recovery"
SMTP_TLS=true

# Database & Cache
DATABASE_URL=postgresql+asyncpg://postgres:postgrespassword@postgres:5432/revivepilot
REDIS_URL=redis://redis:6379/0

# JWT
JWT_SECRET_KEY=revivepilot-super-secret-key-development-32chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
