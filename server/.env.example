# ==============================================================================
# RevivePilot — Backend Environment Configuration Example
# ==============================================================================

APP_NAME=RevivePilot
APP_ENV=development
DEBUG=true

# Database & Redis
DATABASE_URL=postgresql+asyncpg://postgres:postgrespassword@postgres:5432/revivepilot
REDIS_URL=redis://redis:6379/0

# Security / JWT
JWT_SECRET_KEY=revivepilot-super-secret-key-development-32chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174

# ==============================================================================
# SMTP Mailer Settings — Put Your Email & Passkey Here
# ==============================================================================
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_APP_PASSWORD=your_16_char_app_password
# SMTP_FROM=your_email@gmail.com
# SMTP_FROM_NAME="RevivePilot Revenue Recovery"
# SMTP_TLS=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_APP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME="RevivePilot Revenue Recovery"
SMTP_TLS=true

# Razorpay Sandbox
RAZORPAY_KEY_ID=rzp_test_mock
RAZORPAY_KEY_SECRET=mock_secret
RAZORPAY_WEBHOOK_SECRET=rzp_webhook_secret_dev

# Gemini AI
GEMINI_API_KEY=mock_gemini_key
