# Application
APP_NAME=RevivePilot
APP_ENV=development
DEBUG=true

# Database (PostgreSQL 16+)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/revivepilot

# Redis
REDIS_URL=redis://localhost:6379/0

# Security & JWT
JWT_SECRET_KEY=change-this-to-a-super-secret-hex-key-in-production-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174

# Razorpay Test Mode (Sandbox only — will be used in future phases)
RAZORPAY_KEY_ID=rzp_test_placeholder
RAZORPAY_KEY_SECRET=placeholder_secret

# AI Providers (Will be used in future agent phases)
GEMINI_API_KEY=placeholder_gemini_key
