# RevivePilot Client — Environment Variable Template
# Copy this file to .env.local and fill in your values.
# Never commit .env.local — it is gitignored.

# ── Backend API ──────────────────────────────────────────────────────────────
# FastAPI backend base URL (Part 4: real integration)
VITE_API_BASE_URL=

# ── WebSocket ────────────────────────────────────────────────────────────────
# WebSocket server URL — leave empty to use demo/mock mode
# Example: ws://localhost:8000/ws  or  wss://api.revivepilot.ai/ws
VITE_WS_URL=

# ── Application ──────────────────────────────────────────────────────────────
# Options: development | production
VITE_APP_ENV=development

# ── NOTE ─────────────────────────────────────────────────────────────────────
# NEVER put secrets, API keys, or payment credentials in environment variables.
# All sensitive credentials must live on the backend only.
