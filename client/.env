# RevivePilot Client — Environment Variables
# This file is committed to source control (no secrets).
# Copy to .env.local to override without committing.

# ── Backend API ──────────────────────────────────────────────────────────────
# FastAPI backend base URL (Part 4 integration)
VITE_API_BASE_URL=http://localhost:8000/api/v1

# ── WebSocket ────────────────────────────────────────────────────────────────
# Native WebSocket server URL (Part 4 integration)
# Leave empty for demo/mock mode (no real WebSocket connection)
VITE_WS_URL=

# ── Application ──────────────────────────────────────────────────────────────
VITE_APP_ENV=development
